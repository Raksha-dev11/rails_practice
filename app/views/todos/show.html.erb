<% content_for :title, @todo.name %>

<% if notice.present? %>
  <div class="mb-4 bg-green-50 border border-green-200 text-green-700 rounded-lg px-4 py-3 text-sm"><%= notice %></div>
<% end %>

<div class="max-w-2xl">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-4">
    <div class="flex items-start justify-between mb-4">
      <h1 class="text-2xl font-bold text-gray-900 <%= @todo.completed? ? 'line-through text-gray-400' : '' %>"><%= @todo.name %></h1>
      <% if @todo.completed? %>
        <span class="text-2xl">✅</span>
      <% end %>
    </div>

    <% if @todo.description.present? %>
      <p class="text-gray-600 mb-4"><%= @todo.description %></p>
    <% end %>

    <div class="grid grid-cols-2 gap-4 text-sm">
      <div>
        <span class="text-gray-400">Priority</span>
        <p class="font-medium text-gray-800"><%= @todo.priority %></p>
      </div>
      <div>
        <span class="text-gray-400">Project</span>
        <p class="font-medium text-gray-800">
          <% if @todo.project %>
            <%= link_to @todo.project.name, project_path(@todo.project), class: "text-blue-600 hover:underline" %>
          <% else %>
            —
          <% end %>
        </p>
      </div>
      <div>
        <span class="text-gray-400">Status</span>
        <p class="font-medium <%= @todo.completed? ? 'text-green-600' : 'text-yellow-600' %>">
          <%= @todo.completed? ? "Completed" : "In progress" %>
        </p>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= link_to "Edit", edit_todo_path(@todo), class: "bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium transition-colors" %>
    <%= button_to "Delete", @todo, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "bg-red-100 hover:bg-red-200 text-red-700 px-4 py-2 rounded-lg text-sm font-medium cursor-pointer transition-colors" %>
    <%= link_to "← Back to todos", todos_path, class: "text-sm text-gray-500 hover:text-blue-600 ml-2" %>
  </div>
</div>
