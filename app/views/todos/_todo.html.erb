<div id="<%= dom_id todo %>" class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
  <div class="flex items-start justify-between">
    <div class="flex items-start gap-3">
      <% if todo.completed? %>
        <span class="mt-0.5 text-green-500 text-lg">✅</span>
      <% else %>
        <span class="mt-1 w-4 h-4 rounded-full border-2 border-gray-300 inline-block flex-shrink-0"></span>
      <% end %>
      <div>
        <p class="font-semibold text-gray-900 <%= todo.completed? ? 'line-through text-gray-400' : '' %>"><%= todo.name %></p>
        <% if todo.description.present? %>
          <p class="text-sm text-gray-500 mt-0.5"><%= todo.description %></p>
        <% end %>
        <div class="flex items-center gap-3 mt-2">
          <span class="text-xs text-gray-400">Priority: <strong><%= todo.priority %></strong></span>
          <% if todo.project %>
            <span class="text-xs text-blue-500"><%= link_to todo.project.name, project_path(todo.project) %></span>
          <% end %>
        </div>
      </div>
    </div>
    <div class="flex items-center gap-3 ml-4">
      <%= link_to "View", todo, class: "text-sm text-gray-400 hover:text-blue-600" %>
    </div>
  </div>
</div>
