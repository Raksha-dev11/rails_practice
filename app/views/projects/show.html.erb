<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-gray-900"><%= @project.name %></h1>
    <% if @project.active %>
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700 mt-1">Active</span>
    <% else %>
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500 mt-1">Inactive</span>
    <% end %>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to "Edit", edit_project_path(@project), class: "bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium transition-colors" %>
    <%= button_to "Delete", project_path(@project), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "bg-red-100 hover:bg-red-200 text-red-700 px-4 py-2 rounded-lg text-sm font-medium cursor-pointer transition-colors" %>
  </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
  <h2 class="text-lg font-semibold text-gray-800 mb-4">Todos</h2>

  <% if @project.todos.empty? %>
    <p class="text-gray-400 text-sm">No todos for this project yet.</p>
  <% else %>
    <ul class="space-y-2">
      <% @project.todos.each do |todo| %>
        <li class="flex items-center gap-3 py-2 border-b border-gray-100 last:border-0">
          <% if todo.completed? %>
            <span class="text-green-500">✅</span>
          <% else %>
            <span class="w-4 h-4 rounded-full border-2 border-gray-300 inline-block"></span>
          <% end %>
          <%= link_to todo.name, todo_path(todo), class: "text-gray-800 hover:text-blue-600 #{todo.completed? ? 'line-through text-gray-400' : ''}" %>
          <span class="ml-auto text-xs text-gray-400">Priority: <%= todo.priority %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>

<div class="mt-4">
  <%= link_to "← Back to projects", projects_path, class: "text-sm text-gray-500 hover:text-blue-600" %>
</div>
